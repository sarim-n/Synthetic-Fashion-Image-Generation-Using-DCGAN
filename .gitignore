# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Caches & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Model Checkpoints (preserve directory structure via .gitkeep)
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.ckpt

# Generated Samples & Output Data (preserve directory structure via .gitkeep)
samples/*
!samples/.gitkeep
*.png
*.jpg
*.jpeg

# Raw & Downloaded Datasets
data/*
!data/.gitkeep

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo

# OS Generated Files
.DS_Store
Thumbs.db

# Logs & Diagnostics
logs/
*.log
